<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:padding="12dp"
    android:maxWidth="320dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/popupWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            tools:text="two-story" />

        <TextView
            android:id="@+id/popupClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/popupMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        tools:text="hai tầng" />

    <TextView
        android:id="@+id/popupExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E0E0E0"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        tools:text="They live in a nice two-story house." />

    <TextView
        android:id="@+id/popupExampleVi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        tools:text="Họ sống trong một ngôi nhà hai tầng đẹp." />

</LinearLayout>
